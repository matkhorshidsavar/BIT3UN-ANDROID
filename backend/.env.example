BIT3UN_DEBUG_HOST=127.0.0.1
BIT3UN_DEBUG_PORT=3337
BIT3UN_CORS_ORIGIN=https://bit3un.ir

# Keep these on the server only. Do not expose them in frontend HTML/JS.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
NOBITEX_API_KEY=
NOBITEX_TOKEN=
NOBITEX_TOMAN_PRICE_API=

# MySQL is intentionally not mutated by the debugger agent.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Optional wallet address source. This must contain public deposit addresses only.
WALLET_CONFIG_PATH=/etc/bit3un/wallet-addresses.json
# Or:
# WALLET_ADDRESSES_JSON={"addresses":[{"asset":"USDT","network":"TRC20","address":"...","state":"active"}]}
